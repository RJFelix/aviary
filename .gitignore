# ── Node / harness build output ──
node_modules/
harness/**/dist/
harness/**/*.tsbuildinfo

# ── Swift build output ──
app/.build/
app/.swiftpm/
build/
*.app/

# ── macOS ──
.DS_Store

# ── Local state ──
*.local
.env
.env.*
untracked/

# ── Snapshot output: contains real session titles from real work ──
build/shots/
docs/screens/

# Workshop screenshots: one PNG per filed request, captured from the live window.
# Useful to the agent servicing the board, not worth carrying in history.
workshop/shots/

# Memory the agent writes about this project. Tracked deliberately? No — reviewable in the
# working tree, but not committed by default: it is one person's accumulated beliefs, and a
# shared repo would need a review gate first. Delete this line to start tracking it.
memory/

# Agent worktrees are checkouts, not content.
.claude/worktrees/

# The vendored Prime Agent fork, removed 2026-08-24. Kept out by name so a stray
# reinstall does not creep back into the tree.
harness/
